{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"title": "Entry",
	"settings": {
		"color": {
			"palette": [
				{
					"name": "Ink",
					"slug": "ink",
					"color": "#17283a"
				},
				{
					"name": "Ocean",
					"slug": "ocean",
					"color": "#0b63b6"
				},
				{
					"name": "Mint",
					"slug": "mint",
					"color": "#e4f4f9"
				},
				{
					"name": "Paper",
					"slug": "paper",
					"color": "#f1f9fc"
				},
				{
					"name": "White",
					"slug": "white",
					"color": "#ffffff"
				}
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"name": "Jost",
					"slug": "jost",
					"fontFamily": "Jost, \"Hiragino Sans\", \"Hiragino Kaku Gothic ProN\", \"Noto Sans JP\", \"Yu Gothic\", YuGothic, Meiryo, sans-serif",
					"fontFace": [
						{
							"fontFamily": "Jost",
							"fontStyle": "normal",
							"fontWeight": "100 900",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/jost/Jost-VariableFont_wght.woff2"
							]
						}
					]
				},
				{
					"name": "Japanese Sans",
					"slug": "jp-sans",
					"fontFamily": "\"Hiragino Sans\", \"Hiragino Kaku Gothic ProN\", \"Noto Sans JP\", \"Yu Gothic\", YuGothic, Meiryo, sans-serif"
				}
			]
		},
		"custom": {
			"robse": {
				"radius": "2rem",
				"design": "entry"
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--white)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--jp-sans)"
		},
		"elements": {
			"button": {
				"border": {
					"radius": "999px"
				},
				"color": {
					"background": "#ffffff",
					"text": "var(--wp--preset--color--ocean)"
				},
				"typography": {
					"fontWeight": "700"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--ink)"
				}
			}
		}
	}
}