{
	"$schema": "https://schemas.wp.org/wp/6.6/theme.json",
	"version": 3,
	"title": "Calm",
	"settings": {
		"color": {
			"palette": [
				{
					"name": "Ink",
					"slug": "ink",
					"color": "#46463f"
				},
				{
					"name": "Ocean",
					"slug": "ocean",
					"color": "#2f8a5f"
				},
				{
					"name": "Mint",
					"slug": "mint",
					"color": "#e6ece0"
				},
				{
					"name": "Paper",
					"slug": "paper",
					"color": "#f2f5ee"
				},
				{
					"name": "White",
					"slug": "white",
					"color": "#fbfcf9"
				}
			]
		},
		"typography": {
			"fontFamilies": [
				{
					"name": "Cardo",
					"slug": "cardo",
					"fontFamily": "Cardo, \"Hiragino Mincho ProN\", \"Yu Mincho\", YuMincho, \"Noto Serif JP\", serif",
					"fontFace": [
						{
							"fontFamily": "Cardo",
							"fontStyle": "normal",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/cardo/cardo_normal_400.woff2"
							]
						},
						{
							"fontFamily": "Cardo",
							"fontStyle": "italic",
							"fontWeight": "400",
							"fontDisplay": "swap",
							"src": [
								"file:./assets/fonts/cardo/cardo_italic_400.woff2"
							]
						}
					]
				},
				{
					"name": "Mincho",
					"slug": "mincho",
					"fontFamily": "\"Hiragino Mincho ProN\", \"Yu Mincho\", YuMincho, \"Noto Serif JP\", serif"
				}
			]
		},
		"custom": {
			"robse": {
				"radius": "0.375rem",
				"design": "calm"
			}
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--white)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--mincho)"
		},
		"elements": {
			"button": {
				"border": {
					"radius": "0"
				},
				"color": {
					"background": "transparent",
					"text": "var(--wp--preset--color--ink)"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--ink)"
				}
			}
		}
	}
}