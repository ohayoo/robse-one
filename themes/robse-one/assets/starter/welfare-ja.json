=\"wp-block-buttons\"><!-- wp:button -->\n<div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"{{page:services}}\">詳しく見る</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons --></div>\n<!-- /wp:group -->\n<!-- wp:group {\"align\": \"wide\", \"layout\": {\"type\": \"constrained\"}, \"style\": {\"spacing\": {\"padding\": {\"top\": \"clamp(1.25rem,4vw,3rem)\", \"right\": \"clamp(1.25rem,4vw,3rem)\", \"bottom\": \"clamp(1.25rem,4vw,3rem)\", \"left\": \"clamp(1.25rem,4vw,3rem)\"}}}, \"backgroundColor\": \"paper\"} -->\n<div class=\"wp-block-group alignwide has-paper-background-color has-background\" style=\"padding-top:clamp(1.25rem,4vw,3rem);padding-right:clamp(1.25rem,4vw,3rem);padding-bottom:clamp(1.25rem,4vw,3rem);padding-left:clamp(1.25rem,4vw,3rem)\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">利用までの流れ</h2>\n<!-- /wp:heading -->\n<!-- wp:paragraph -->\n<p>まずは見学へ。作業の様子や通所について気になることをお聞かせください。</p>\n<!-- /wp:paragraph -->\n<!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button -->\n<div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"{{page:case}}\">流れを確認する</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons --></div>\n<!-- /wp:group -->\n<!-- wp:group {\"align\": \"wide\", \"layout\": {\"type\": \"constrained\"}, \"style\": {\"spacing\": {\"padding\": {\"top\": \"clamp(1.25rem,4vw,3rem)\", \"right\": \"clamp(1.25rem,4vw,3rem)\", \"bottom\": \"clamp(1.25rem,4vw,3rem)\", \"left\": \"clamp(1.25rem,4vw,3rem)\"}}}} -->\n<div class=\"wp-block-group alignwide\" style=\"padding-top:clamp(1.25rem,4vw,3rem);padding-right:clamp(1.25rem,4vw,3rem);padding-bottom:clamp(1.25rem,4vw,3rem);padding-left:clamp(1.25rem,4vw,3rem)\"><!-- wp:heading -->\n<h2 class=\"wp-block-heading\">事業所案内</h2>\n<!-- /wp:heading -->\n<!-- wp:paragraph -->\n<p>働くことに少しずつ慣れていくための、地域の小さな作業所です。</p>\n<!-- /wp:paragraph -->\n<!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button -->\n<div class=\"wp-b