実際の選考手順と問い合わせ先を掲載してください。</p>\n<!-- /wp:paragraph --></div>\n<!-- /wp:group -->\n<!-- wp:group {\"align\": \"wide\", \"layout\": {\"type\": \"constrained\"}, \"style\": {\"spacing\": {\"padding\": {\"top\": \"clamp(1.25rem,4vw,3rem)\", \"right\": \"clamp(1.25rem,4vw,3rem)\", \"bottom\": \"clamp(1.25rem,4vw,3rem)\", \"left\": \"clamp(1.25rem,4vw,3rem)\"}}}, \"backgroundColor\": \"mint\"} -->\n<div class=\"wp-block-group alignwide has-mint-background-color has-background\" style=\"padding-top:clamp(1.25rem,4vw,3rem);padding-right:clamp(1.25rem,4vw,3rem);padding-bottom:clamp(1.25rem,4vw,3rem);padding-left:clamp(1.25rem,4vw,3rem)\"><!-- wp:buttons -->\n<div class=\"wp-block-buttons\"><!-- wp:button -->\n<div class=\"wp-block-button\"><a class=\"wp-block-button__link wp-element-button\" href=\"{{page:contact}}\">応募・職場見学を相談する</a></div>\n<!-- /wp:button --></div>\n<!-- /wp:buttons --></div>\n<!-- /wp:group -->"
